# Kopiere diese Datei nach .env und trage deine eigenen Schlüssel ein.
# Die echte .env wird NIEMALS committet (siehe .gitignore).

# Nur für lokalen Dev-Start (python app.py) relevant. Auf dem VPS bindet
# Gunicorn den Port selbst (siehe systemd-Unit), .env/PORT wird dort nicht
# zwingend gebraucht — kann aber synchron gehalten werden.
HOST=127.0.0.1
PORT=5000

MAPTILER_API_KEY=

CDS_API_URL=
CDS_API_KEY=

# Nur für lokale Skripte mit NASA-Earthdata-Zugriff (GRACE), die App selbst braucht ihn nicht.
# Token erzeugen unter https://urs.earthdata.nasa.gov (Profil → Generate Token).
EARTHDATA_BEARER_TOKEN=
EARTHDATA_TOKEN_EXPIRES=
